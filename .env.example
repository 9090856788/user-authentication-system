# Server Environment & Port
PORT=3000
NODE_ENV=development

# MongoDB Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/user_auth_db?retryWrites=true&w=majority

# JWT Token Secrets (Minimum 32 characters)
ACCESS_TOKEN_SECRET=your_jwt_access_secret_key_minimum_32_characters
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_key_minimum_32_characters

# Nodemailer Configuration (for email verification and password reset)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Initial Administrator Seed Configuration (Optional)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=AdminPassword123!
